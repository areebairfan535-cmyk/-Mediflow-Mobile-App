# Copy to .env and adjust. NEVER commit .env — it is gitignored.

APP_NAME=MediFlow
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# XAMPP defaults: user root, empty password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mediflow
DB_USERNAME=root
DB_PASSWORD=

# Auth (plan sec 11)
AUTH_ACCESS_TTL_MINUTES=30
AUTH_REFRESH_TTL_DAYS=30
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

# Rate limiting (plan sec 17)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10

# Uploads (plan sec 19)
MAX_UPLOAD_MB=25

# Comma-separated origins, or * during local development.
CORS_ORIGINS=*

# ---------------------------------------------------------------
# Later phases. Left blank until the relevant phase is built, so the
# app must never assume any of these exist.
#
# Phase 3 - payments (sec 7)
# PAYMENT_GATEWAY=
# PAYMENT_PUBLIC_KEY=
# PAYMENT_SECRET_KEY=
#
# Phase 2/4 - notifications (sec 20). Nothing here is required: with no
# credentials the worker marks those channels "not configured" and the in-app
# inbox keeps working. Send them with:
#   php database/notify.php            once (put it on cron, every minute)
#   php database/notify.php --status   what is configured, what is waiting
#
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587                 587 uses STARTTLS; 465 is not supported
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@yourclinic.com
# MAIL_FROM_NAME=Your Clinic
#
# Any HTTP SMS gateway: {to} and {message} are filled in.
# SMS_ENDPOINT=https://gateway.example.com/send
# SMS_METHOD=POST
# SMS_API_KEY=
#
# Phase 6 - AI (sec 9). Unset = assistants report "not configured" and
# every other feature is unaffected.
#   AI_PROVIDER=anthropic  real assistants; needs ANTHROPIC_API_KEY
#   AI_PROVIDER=stub       offline, rules-only, for development and the test
#                          suite. Refused when APP_ENV=production.
# AI_PROVIDER=
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
# AI_TIMEOUT_SECONDS=60
# ---------------------------------------------------------------
