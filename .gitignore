# dependencies
node_modules/
vendor/

# Environment — real credentials. Copy backend/.env.example to backend/.env
.env
.env.*
!.env.example

# Backend runtime state
backend/storage/logs/*
!backend/storage/logs/.gitkeep
backend/storage/app/public/*
!backend/storage/app/public/.gitkeep
backend/storage/app/public/documents/*
!backend/storage/app/public/documents/.gitkeep

# Build output — regenerated by `npm run build`
dist/
build/
web-build/

# Expo
.expo/
expo-env.d.ts

# Logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# Generated native folders
/ios
/android
*/ios/
*/android/

# Native credentials — never commit these
*.jks
*.p8
*.p12
*.keystore
*.mobileprovision
*.pem

# Editor / OS
.DS_Store
Thumbs.db
*.tsbuildinfo

# Test artefacts written by the smoke suites, which run from backend/database
backend/database/*.pdf

# Backups hold a full database dump — patient data. Never in version control.
backend/storage/backups/

# Test runner output
backend/database/last-run.log

# Stub push service the test suite spins up
backend/database/.pushmock/

# Route dumper the API suite writes and deletes; only survives an interrupt.
backend/database/.routes-dump.php
